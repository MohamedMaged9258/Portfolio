{
  // Cloudflare Workers static-assets config (deterministic, replaces the auto-generated setup).
  // Cloudflare runs `npm run build` then `npx wrangler deploy`, which uploads ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    // Resolves an extensionless /projects/homelab to projects/homelab/index.html.
    // This is the default, but scripts/prerender.mjs depends on it for social-scraper
    // metadata to be served at all, so it's pinned rather than left implicit.
    "html_handling": "auto-trailing-slash",
    // Fallback for routes with no prerendered file (e.g. a mistyped URL): serve
    // dist/404.html with a real 404 status. "single-page-application" returned 200 for
    // every unknown URL — a soft 404 that wasted crawl budget and made /robots.txt
    // resolve to the HTML shell. Every genuine route is emitted as its own file by
    // scripts/prerender.mjs and matches above, so nothing real reaches this.
    "not_found_handling": "404-page"
  }
}
