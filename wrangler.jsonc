{
  // Cloudflare Workers static-assets config (deterministic, replaces the auto-generated setup).
  // Cloudflare runs `npm run build` then `npx wrangler deploy`, which uploads ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    // Serves projects/homelab/index.html at the extensionless /projects/homelab, and
    // redirects the trailing-slash form to it.
    //
    // NOT the "auto-trailing-slash" default, which does the opposite for this layout:
    // it treats /projects/homelab/ as the canonical form and 307s the bare path to it.
    // Every URL the site emits — canonical tags, og:url, sitemap.xml entries, JSON-LD
    // @ids, internal links — is slash-less, so under the default every one of them was
    // a redirect, and the page that did answer 200 declared a canonical pointing at a
    // redirect. Google reports that as "Page with redirect" and indexes nothing.
    "html_handling": "drop-trailing-slash",
    // Fallback for routes with no prerendered file (e.g. a mistyped URL): serve
    // dist/404.html with a real 404 status. "single-page-application" returned 200 for
    // every unknown URL — a soft 404 that wasted crawl budget and made /robots.txt
    // resolve to the HTML shell. Every genuine route is emitted as its own file by
    // scripts/prerender.mjs and matches above, so nothing real reaches this.
    "not_found_handling": "404-page"
  }
}
